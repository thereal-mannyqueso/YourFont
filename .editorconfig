root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,manifest,json}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:suggestion

# Logging performance rules (LoggerMessage source generators) are aimed at
# high-throughput servers. FontBook logs rarely, so readability wins.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# WPF and xUnit call into our code via reflection/binding; these rules produce noise there.
dotnet_diagnostic.CA1515.severity = none

[tests/**.cs]
# Test names use the Method_Scenario_ExpectedResult convention.
dotnet_diagnostic.CA1707.severity = none
