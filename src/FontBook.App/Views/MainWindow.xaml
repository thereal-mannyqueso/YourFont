<Window x:Class="FontBook.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FontBook.App.ViewModels"
        xmlns:views="clr-namespace:FontBook.App.Views"
        xmlns:models="clr-namespace:FontBook.Core.Models;assembly=FontBook.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FontBook"
        Width="1240" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True">

    <!--
      WindowChrome extends our content into the title bar area (like File Explorer and Settings).
      GlassFrameThickness=-1 keeps the native minimize/maximize/close buttons (with Snap Layouts),
      and lets the Mica material show through. If Mica isn't available, MainWindow.xaml.cs
      removes this and falls back to the standard title bar.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <!-- Ctrl+F focuses the search box. -->
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay, Converter={StaticResource DoubleToGridLength}}"
                              MinWidth="180" MaxWidth="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Title bar ============ -->
        <StackPanel x:Name="AppTitle" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                <TextBlock Text="Aa" FontFamily="Georgia" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextOnAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
            </Border>
            <TextBlock Text="FontBook" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <Border x:Name="SearchBox" Grid.Column="1" Height="32" MaxWidth="420" Margin="24,0,150,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                WindowChrome.IsHitTestVisibleInChrome="True"
                CornerRadius="6" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlFillFocusBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="11,0,8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="SearchTextBox" Grid.Column="1" Style="{StaticResource BareTextBox}"
                         Tag="Search fonts and styles   (Ctrl+F)"
                         AutomationProperties.Name="Search fonts"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                        AutomationProperties.Name="Clear search"
                        MinWidth="26" MinHeight="26" Padding="0" Margin="0,0,3,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ============ Sidebar ============ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:SidebarView DataContext="{Binding Sidebar}" />

            <!-- Appearance switch -->
            <StackPanel Grid.Row="1" Margin="16,8,16,16">
                <TextBlock Text="APPEARANCE" Style="{StaticResource Text.SectionHeader}" Margin="4,0,0,8" />
                <Border CornerRadius="7" Padding="2" Background="{DynamicResource SubtleFillHoverBrush}">
                    <UniformGrid Columns="3">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme" ToolTip="Match the Windows setting"
                                     AutomationProperties.Name="System theme"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:AppTheme.System}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Auto" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme" ToolTip="Light theme"
                                     AutomationProperties.Name="Light theme"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:AppTheme.Light}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Light" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme" ToolTip="Dark theme"
                                     AutomationProperties.Name="Dark theme"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:AppTheme.Dark}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Dark" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============ Content card ============ -->
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerBackgroundBrush}" BorderBrush="{DynamicResource LayerStrokeBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding FontListWidth, Mode=TwoWay, Converter={StaticResource DoubleToGridLength}}"
                                      MinWidth="220" MaxWidth="520" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <views:FontListView />

                <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerBrush}">
                    <views:PreviewView />
                </Border>

                <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" HorizontalAlignment="Left"
                              Margin="-3,0,0,0" ResizeBehavior="PreviousAndCurrent" />
            </Grid>
        </Border>

        <!-- Sidebar resize handle, centered on the sidebar/content edge. -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Style="{StaticResource PaneSplitter}" HorizontalAlignment="Left"
                      Margin="-3,0,0,0" ResizeBehavior="PreviousAndCurrent" Panel.ZIndex="1" />
    </Grid>
</Window>
