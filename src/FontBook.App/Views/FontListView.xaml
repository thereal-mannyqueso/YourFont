<UserControl x:Class="FontBook.App.Views.FontListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FontBook.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Star button: always shown for favorites, otherwise only on hover/selection. -->
        <Style x:Key="FavoriteButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Add to Favorites" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="Remove from Favorites" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StarGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Text" Value="&#xE734;" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Text" Value="&#xE735;" />
                    <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <StackPanel Margin="20,18,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource Text.Subtitle}" />
                <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0"
                        Visibility="{Binding IsSampleData, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="These fonts come from a built-in sample list, not from scanning this PC. Real font discovery arrives in the next milestone.">
                    <TextBlock Text="Sample data" />
                </Border>
            </Grid>
            <TextBlock Text="{Binding SectionSubtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
        </StackPanel>

        <ListBox x:Name="FontsList" Grid.Row="1"
                 Style="{StaticResource FontList}"
                 ItemContainerStyle="{StaticResource FontListItem}"
                 ItemsSource="{Binding VisibleFamilies}"
                 SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                 AutomationProperties.Name="Fonts">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FontFamilyViewModel}">
                    <Grid Background="Transparent" Tag="{Binding DataContext, ElementName=Root}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="Add to Favorites" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Header" Value="Remove from Favorites" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Remove from This Collection"
                                          Visibility="{Binding PlacementTarget.Tag.IsCollectionSelected, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}"
                                          Command="{Binding PlacementTarget.Tag.RemoveFromCurrentCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <StackPanel VerticalAlignment="Center">
                            <!-- The family name drawn in its own typeface, like Font Book. -->
                            <TextBlock Text="{Binding FamilyName}" FontFamily="{Binding PreviewFamily}" FontSize="17"
                                       LineStackingStrategy="BlockLineHeight" LineHeight="24"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StyleCountText}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource FavoriteButton}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Toggle favorite">
                            <TextBlock Style="{StaticResource StarGlyph}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,60" MaxWidth="260"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding EmptyGlyph}" FontSize="32"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.BodyStrong}" FontSize="15"
                       HorizontalAlignment="Center" Margin="0,14,0,6" />
            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Caption}" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Loading fonts…" Style="{StaticResource Text.Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
