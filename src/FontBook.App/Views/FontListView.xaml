<UserControl x:Class="FontBook.App.Views.FontListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FontBook.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Star button: always shown for favorites, otherwise only on hover/selection. -->
        <Style x:Key="FavoriteButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Add to Favorites" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="Remove from Favorites" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StarGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Text" Value="&#xE734;" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Text" Value="&#xE735;" />
                    <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <StackPanel Margin="20,18,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource Text.Subtitle}" />
                <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0"
                        Visibility="{Binding IsSampleData, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="These fonts come from a built-in sample list, not from scanning this PC. Real font discovery arrives in the next milestone.">
                    <TextBlock Text="Sample data" />
                </Border>
            </Grid>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SectionSubtitle}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />

                <!-- Sort menu -->
                <ToggleButton x:Name="SortToggle" Grid.Column="1" Style="{StaticResource SubtleButton}" Padding="6,2" MinHeight="24" MinWidth="0"
                              ToolTip="Sort fonts" AutomationProperties.Name="Sort fonts"
                              IsChecked="{Binding IsSortMenuOpen, Mode=TwoWay}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=SortPopup, Converter={StaticResource InverseBoolean}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SortLabel}" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortToggle}" Placement="Bottom" VerticalOffset="2" HorizontalOffset="-150"
                       IsOpen="{Binding IsChecked, ElementName=SortToggle, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="8" Width="250" Padding="4,6" CornerRadius="8"
                            Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupStrokeBrush}" BorderThickness="1"
                            TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.22" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="SORT BY" Style="{StaticResource Text.SectionHeader}" Margin="12,2,0,6" />
                            <ItemsControl ItemsSource="{Binding SortOptions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SortChoiceViewModel}">
                                        <RadioButton Style="{StaticResource NavItem}" GroupName="SortOptions" Margin="0,1" MinHeight="30"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}"
                                                     AutomationProperties.Name="{Binding Label, StringFormat=Sort by {0}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Category filter chips -->
            <ItemsControl ItemsSource="{Binding CategoryChips}" Margin="0,12,0,0" Focusable="False"
                          AutomationProperties.Name="Filter by category">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryChoiceViewModel}">
                        <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     AutomationProperties.Name="{Binding Label, StringFormat=Category {0}}">
                            <TextBlock>
                                <Run Text="{Binding Label, Mode=OneWay}" />
                                <Run Text="{Binding Count, Mode=OneWay}" FontSize="11" />
                            </TextBlock>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ListBox x:Name="FontsList" Grid.Row="1"
                 Style="{StaticResource FontList}"
                 ItemContainerStyle="{StaticResource FontListItem}"
                 ItemsSource="{Binding VisibleFamilies}"
                 SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                 AutomationProperties.Name="Fonts">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FontFamilyViewModel}">
                    <Grid Background="Transparent" Tag="{Binding DataContext, ElementName=Root}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="Add to Favorites" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Header" Value="Remove from Favorites" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Remove from This Collection"
                                          Visibility="{Binding PlacementTarget.Tag.IsCollectionSelected, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}"
                                          Command="{Binding PlacementTarget.Tag.RemoveFromCurrentCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Install for My Account"
                                          Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"
                                          Command="{Binding PlacementTarget.Tag.InstallCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Uninstall&#x2026;"
                                          Visibility="{Binding IsUserFont, Converter={StaticResource BoolToVisibility}}"
                                          Command="{Binding PlacementTarget.Tag.UninstallCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Share as ZIP&#x2026; (Beta)"
                                          Visibility="{Binding CanShare, Converter={StaticResource BoolToVisibility}}"
                                          Command="{Binding PlacementTarget.Tag.ShareCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Remove from Font Vault&#x2026;"
                                          Visibility="{Binding IsImported, Converter={StaticResource BoolToVisibility}}"
                                          Command="{Binding PlacementTarget.Tag.RemoveFromVaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <StackPanel VerticalAlignment="Center">
                            <!-- The family name drawn in its own typeface, like Font Book. -->
                            <TextBlock Text="{Binding FamilyName}" FontFamily="{Binding PreviewFamily}" FontSize="17"
                                       FontWeight="{Binding PreviewWeight}" FontStyle="{Binding PreviewStyle}" FontStretch="{Binding PreviewStretch}"
                                       LineStackingStrategy="BlockLineHeight" LineHeight="24"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ListCaption}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource FavoriteButton}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Toggle favorite">
                            <TextBlock Style="{StaticResource StarGlyph}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,60" MaxWidth="260"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding EmptyGlyph}" FontSize="32"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.BodyStrong}" FontSize="15"
                       HorizontalAlignment="Center" Margin="0,14,0,6" />
            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Caption}" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="None" />
            <Button Style="{StaticResource AccentButton}" Content="Import Fonts&#x2026;" Margin="0,18,0,0" HorizontalAlignment="Center"
                    Command="{Binding ImportFontsCommand}" AutomationProperties.Name="Import Fonts"
                    Visibility="{Binding ShowImportAction, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Loading fonts…" Style="{StaticResource Text.Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
