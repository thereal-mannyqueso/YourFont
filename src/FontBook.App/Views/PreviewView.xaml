<UserControl x:Class="FontBook.App.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FontBook.App.ViewModels"
             xmlns:controls="clr-namespace:FontBook.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Gentle fade + rise used when the previewed font changes. -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="6" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Nothing selected -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Preview.HasFamily, Converter={StaticResource BoolToVisibilityEx}, ConverterParameter=Invert}">
            <TextBlock Text="Aa" FontFamily="Georgia" FontSize="56" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" Opacity="0.6" />
            <TextBlock Text="Select a font to preview it" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Visibility="{Binding Preview.HasFamily, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header ============ -->
            <Grid Margin="28,18,20,0">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <!-- Fires when the family-name binding below updates, i.e. a new font was selected. -->
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Preview.Family.FamilyName, NotifyOnTargetUpdated=True}" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                        <Run Text="{Binding Preview.Family.StyleCountText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Preview.Family.SourceText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                    <!-- Favorite -->
                    <Button Style="{StaticResource SubtleButton}" Padding="10,6"
                            Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding Preview.Family}"
                            AutomationProperties.Name="Toggle favorite">
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Preview.Family}">
                            <TextBlock FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE734;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Favorite" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="Favorited" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Install (Font Vault fonts that aren't installed yet) -->
                    <Button Style="{StaticResource AccentButton}" Padding="14,6" Margin="0,0,6,0" VerticalAlignment="Center"
                            Command="{Binding InstallCommand}" CommandParameter="{Binding Preview.Family}"
                            Visibility="{Binding Preview.Family.CanInstall, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                            ToolTip="Install for your Windows account so all your apps can use it"
                            AutomationProperties.Name="Install font">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Foreground="{DynamicResource TextOnAccentBrush}" />
                            <TextBlock Text="Install" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Already installed (Font Vault fonts whose family is installed in Windows) -->
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0"
                            ToolTip="A font with this name is installed in Windows."
                            Visibility="{Binding Preview.Family.IsAlsoInstalled, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <TextBlock Text="Installed" />
                    </Border>

                    <!-- Uninstall (fonts installed for this user only) -->
                    <Button Style="{StaticResource SubtleButton}" Padding="10,6" Margin="4,0,0,0"
                            Command="{Binding UninstallCommand}" CommandParameter="{Binding Preview.Family}"
                            Visibility="{Binding Preview.Family.IsUserFont, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                            ToolTip="Remove this font from Windows for your account"
                            AutomationProperties.Name="Uninstall font">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Uninstall&#x2026;" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Remove (Font Vault fonts only) -->
                    <Button Style="{StaticResource SubtleButton}" Padding="10,6" Margin="4,0,0,0"
                            Command="{Binding RemoveFromVaultCommand}" CommandParameter="{Binding Preview.Family}"
                            Visibility="{Binding Preview.Family.IsImported, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                            ToolTip="Delete FontBook's copy. Your original file is not affected."
                            AutomationProperties.Name="Remove from Font Vault">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Remove" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Collections menu -->
                    <ToggleButton x:Name="CollectionsToggle" Style="{StaticResource SubtleButton}" Padding="10,6" Margin="4,0,0,0"
                                  AutomationProperties.Name="Collections"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=CollectionsPopup, Converter={StaticResource InverseBoolean}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="14" />
                            <TextBlock Text="Collections" Margin="8,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="CollectionsPopup" PlacementTarget="{Binding ElementName=CollectionsToggle}"
                           Placement="Bottom" HorizontalOffset="-130" VerticalOffset="2"
                           IsOpen="{Binding IsChecked, ElementName=CollectionsToggle, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Margin="8" Width="270" Padding="6,8" CornerRadius="8"
                                Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupStrokeBrush}" BorderThickness="1"
                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.22" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,8,6">
                                    <Run Text="Add" />
                                    <Run Text="{Binding Preview.Family.FamilyName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="to:" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Memberships}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CollectionMembershipViewModel}">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsMember}" Margin="8,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="8,2,8,4"
                                           Visibility="{Binding HasCollections, Converter={StaticResource BoolToVisibilityEx}, ConverterParameter=Invert}"
                                           Text="You don't have any collections yet. Use the + button next to Custom Collections in the sidebar to create one." />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- ============ Specimen controls ============ -->
            <Grid Grid.Row="1" Margin="28,16,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource FieldTextBox}" Tag="Type your own sample text…"
                         AutomationProperties.Name="Sample text"
                         Text="{Binding Preview.SpecimenText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Margin="4,0,0,0"
                        Command="{Binding Preview.ResetSpecimenCommand}"
                        ToolTip="Reset sample text" AutomationProperties.Name="Reset sample text">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="A" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Slider Width="150" Margin="8,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Preview size"
                            Minimum="{x:Static vm:PreviewViewModel.MinPointSize}"
                            Maximum="{x:Static vm:PreviewViewModel.MaxPointSize}"
                            SmallChange="1" LargeChange="8"
                            Value="{Binding Preview.PointSize}" />
                    <TextBlock Text="A" FontSize="17" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Preview.PointSize, Converter={StaticResource PointSizeText}}" Width="48"
                               Margin="10,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Grid>

            <!-- ============ Specimens ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="28,0,20,28">
                    <!-- Large preview of the selected style -->
                    <Border CornerRadius="10" Padding="28,22,28,26" MinHeight="160"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                        <controls:FontPreview Caption="{Binding Preview.SelectedFace.StyleName}"
                                              PreviewFontFamily="{Binding Preview.SelectedFace.FontFamily, NotifyOnTargetUpdated=True}"
                                              PreviewFontWeight="{Binding Preview.SelectedFace.FontWeight, NotifyOnTargetUpdated=True}"
                                              PreviewFontStyle="{Binding Preview.SelectedFace.FontStyle}"
                                              PreviewFontStretch="{Binding Preview.SelectedFace.FontStretch}"
                                              Text="{Binding Preview.SpecimenText}"
                                              FallbackText="{x:Static vm:PreviewViewModel.DefaultSpecimenText}"
                                              PointSize="{Binding Preview.PointSize}">
                            <controls:FontPreview.RenderTransform>
                                <TranslateTransform />
                            </controls:FontPreview.RenderTransform>
                            <controls:FontPreview.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                                </EventTrigger>
                            </controls:FontPreview.Triggers>
                        </controls:FontPreview>
                    </Border>

                    <!-- All styles; clicking one shows it in the large preview -->
                    <TextBlock Text="STYLES" Style="{StaticResource Text.SectionHeader}" Margin="2,24,0,10" />
                    <ItemsControl ItemsSource="{Binding Preview.Family.Faces}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FontFaceViewModel}">
                                <RadioButton Style="{StaticResource FaceRow}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding StyleName}">
                                    <controls:FontPreview Caption="{Binding StyleName}"
                                                          PreviewFontFamily="{Binding FontFamily}"
                                                          PreviewFontWeight="{Binding FontWeight}"
                                                          PreviewFontStyle="{Binding FontStyle}"
                                                          PreviewFontStretch="{Binding FontStretch}"
                                                          Text="{Binding DataContext.Preview.SpecimenText, ElementName=Root}"
                                                          FallbackText="{x:Static vm:PreviewViewModel.DefaultSpecimenText}"
                                                          PointSize="{x:Static vm:PreviewViewModel.StyleRowPointSize}"
                                                          IsSingleLine="True" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
