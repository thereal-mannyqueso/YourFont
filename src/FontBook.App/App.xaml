<Application x:Class="FontBook.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FontBook.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <!-- No StartupUri: the main window is created by dependency injection in App.xaml.cs. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the color palette. ThemeService replaces it with Dark.xaml when needed. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityEx" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBoolean" />
            <converters:EnumEqualsConverter x:Key="EnumEquals" />
            <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLength" />
            <converters:PointSizeTextConverter x:Key="PointSizeText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
