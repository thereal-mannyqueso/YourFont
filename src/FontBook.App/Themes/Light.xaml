<!--
  Light theme palette. Every style uses these keys through DynamicResource,
  so ThemeService can swap this whole file for Dark.xaml at runtime.
  Keep the set of keys identical in both files.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#005FB8</Color>
    <Color x:Key="ShadowColor">#33000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="LayerStrokeBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FCFCFC" />
    <SolidColorBrush x:Key="PopupStrokeBrush" Color="#DADADA" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E5E5E" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B8B8B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#196EBF" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="#E0A100" />

    <!-- Subtle (ghost) fills for list rows, nav items and icon buttons -->
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtleFillSelectedBrush" Color="#10000000" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#06000000" />

    <!-- Input controls -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillFocusBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8A8A8A" />

    <!-- Badges -->
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#14005FB8" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#005FB8" />

</ResourceDictionary>
