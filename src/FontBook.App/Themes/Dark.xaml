<!--
  Dark theme palette. Must define exactly the same keys as Light.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#60CDFF</Color>
    <Color x:Key="ShadowColor">#66000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#272727" />
    <SolidColorBrush x:Key="LayerStrokeBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#333333" />
    <SolidColorBrush x:Key="DividerBrush" Color="#353535" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="PopupStrokeBrush" Color="#444444" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5AB9E6" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="#FFC83D" />

    <!-- Subtle (ghost) fills -->
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillSelectedBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#0AFFFFFF" />

    <!-- Input controls -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillFocusBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#4D4D4D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9F9F9F" />

    <!-- Badges -->
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#2460CDFF" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#60CDFF" />

</ResourceDictionary>
