<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FontBook.App: the WPF desktop application (views, view models, themes, controls).
    It composes everything together with dependency injection in App.xaml.cs.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FontBook</AssemblyName>
    <RootNamespace>FontBook.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Required by the [LibraryImport] source generator used for Windows API calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FontBook.Core\FontBook.Core.csproj" />
    <ProjectReference Include="..\FontBook.Infrastructure\FontBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
  </ItemGroup>

</Project>
